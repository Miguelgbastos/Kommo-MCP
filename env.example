# Kommo CRM Configuration
KOMMO_BASE_URL=https://seu-dominio.kommo.com
KOMMO_ACCESS_TOKEN=seu-token-aqui
KOMMO_TIMEOUT_MS=15000
# Inteiro entre 0 e 10; use 0 para desativar retentativas de leitura
KOMMO_MAX_RETRIES=3
# Limite coordenado por processo; mantenha em no máximo 6 req/s
KOMMO_REQUESTS_PER_SECOND=6
# Opcional: sobrescreve o fuso informado pela conta Kommo (formato IANA)
# KOMMO_TIMEZONE=America/Sao_Paulo

# Server Configuration
PORT=3001
NODE_ENV=production
MCP_HOST=127.0.0.1

# Optional: Security
# MCP_ALLOWED_ORIGINS=http://localhost:3000,https://cursor.com
# MCP_AUTH_TOKEN=seu-token-mcp-aqui
# Allow-list opcional de IPs clientes (vírgula). Recomendado fora de loopback.
# MCP_ALLOWED_IPS=203.0.113.10,198.51.100.20
# Confie no X-Forwarded-For apenas atrás de proxy conhecido (true|false|hops).
# MCP_TRUST_PROXY=1
# MCP_RATE_LIMIT_PER_MINUTE=120
# A confirmação é obrigatória por padrão. Use false somente se aceitar o risco.
# MCP_CONFIRM_WRITES=false

# Optional: Logging
LOG_LEVEL=info
