{
  "name": "kommo-mcp-server",
  "version": "2.0.0",
  "description": "MCP (Model Context Protocol) Server for Kommo CRM integration — expõe tools, resources e prompts para clientes MCP como Cursor e Claude.",
  "main": "dist/http-streamable.js",
  "type": "module",
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node dist/http-streamable.js",
    "dev": "ts-node --esm src/http-streamable.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.mjs\" \".github/**/*.yml\" \"*.{md,json,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.mjs\" \".github/**/*.yml\" \"*.{md,json,yml}\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kommo",
    "kommo-crm",
    "crm",
    "api",
    "cursor",
    "claude",
    "llm",
    "ai"
  ],
  "author": {
    "name": "Miguel G. Bastos",
    "url": "https://github.com/Miguelgbastos"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miguelgbastos/Kommo-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Miguelgbastos/Kommo-MCP/issues"
  },
  "homepage": "https://github.com/Miguelgbastos/Kommo-MCP#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "env.example"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
