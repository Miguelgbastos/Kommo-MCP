{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "allowJs": true
  },
  "esm": true,
  "experimentalEsm": true,
  "extensions": [".ts"],
  "moduleTypes": {
    "*": "esm"
  }
}
