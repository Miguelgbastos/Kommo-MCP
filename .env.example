# Kommo MCP Server - Environment Configuration

# ========================
# SERVER CONFIGURATION
# ========================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# ========================
# KOMMO API
# ========================
KOMMO_BASE_URL=https://api-g.kommo.com
KOMMO_ACCESS_TOKEN=your_kommo_api_token_here

# ========================
# MCP PROTOCOL
# ========================
MCP_PROTOCOL_VERSION=2.1
MCP_SESSION_TIMEOUT=1800000  # 30 minutes in milliseconds

# ========================
# CACHE CONFIGURATION
# ========================
CACHE_DEFAULT_TTL=300000     # 5 minutes in milliseconds
CACHE_LEADS_TTL=300000       # 5 minutes
CACHE_CONTACTS_TTL=300000    # 5 minutes
CACHE_COMPANIES_TTL=600000   # 10 minutes
CACHE_ANALYTICS_TTL=900000   # 15 minutes

# ========================
# DASHBOARD FRONTEND
# ========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_TOKEN=your_dashboard_token_here

# ========================
# OPTIONAL: EXTERNAL SERVICES
# ========================
# Redis (for advanced caching)
REDIS_URL=redis://localhost:6379

# Winston Logging (structured logging)
LOG_FORMAT=json  # json or text
LOG_FILE_PATH=./logs

# ========================
# SECURITY
# ========================
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=100

# ========================
# ANALYTICS & MONITORING
# ========================
ENABLE_METRICS=true
METRICS_PORT=9090
